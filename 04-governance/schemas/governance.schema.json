{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecp.dev/schemas/governance.schema.json",
  "title": "Registro de autoridade (Governance)",
  "description": "Declaração de quem pode decidir o quê (ECP-400 §2): papéis, escopos, e delegações. A origem da autoridade é 'papel' (herança por role) ou 'delegacao' (delegação registrada).",
  "type": "object",
  "required": ["kind", "authorities"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "governance" },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/authority"
      }
    }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "required": ["actor", "role", "scope", "source"],
      "additionalProperties": false,
      "properties": {
        "actor": { "type": "string" },
        "role": { "type": "string" },
        "scope": { "type": "string" },
        "source": {
          "enum": ["papel", "delegacao"]
        },
        "delegation_ref": { "type": "string" },
        "from": { "type": "string" },
        "until": { "type": "string" }
      }
    }
  }
}

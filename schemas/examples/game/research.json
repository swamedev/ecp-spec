{
  "contract": "research",
  "state": "Research",
  "inputs": {
    "knowledge_map": "KnowledgeMap",
    "gaps": "KnowledgeGap[]"
  },
  "outputs": {
    "evidence": "Evidence[]",
    "updated_knowledge": "KnowledgeMap"
  },
  "required": ["gaps_reduced_or_reasoned"],
  "exit": {
    "condition": "P(retencao_D1 >= 0.30) >= 0.70",
